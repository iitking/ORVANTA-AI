# ==========================================
# ORVANTA AI - Configuration Environment
# ==========================================

# --- Core Platform Settings ---
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=replace-with-a-secure-random-secret-key-32-chars-min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Database & Cache ---
DATABASE_URL=postgresql+asyncpg://orvanta:orvanta_secure_password@localhost:5432/orvanta_ai
REDIS_URL=redis://localhost:6379/0

# --- Vector Database (Qdrant) ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=orvanta_knowledge_base

# --- AI & LLM Providers ---
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxx
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx
GEMINI_API_KEY=AIzaxxxxxxxxxxxx
DEFAULT_LLM_MODEL=gpt-4o-mini
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small
OLLAMA_BASE_URL=http://localhost:11434

# --- LangSmith Observability ---
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=lsv2_pt_xxxxxxxxxxxx
LANGCHAIN_PROJECT=orvanta-ai-production

# --- Automation Engine (n8n) ---
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=
N8N_WEBHOOK_SECRET=

# --- Integrations ---
# Slack
SLACK_BOT_TOKEN=xoxb-xxxxxxxxxxxx
SLACK_SIGNING_SECRET=xxxxxxxxxxxx

# Google Workspace / Gmail
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# CRM (HubSpot / Salesforce)
HUBSPOT_ACCESS_TOKEN=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=

# --- MLflow & Analytics ---
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=orvanta_predictive_models

# --- Frontend URL ---
NEXT_PUBLIC_API_URL=http://localhost:8000
